#!/bin/sh
set -eu

owner_file="/var/lib/bibcode-server-package/workstation-user"
root_file="/var/lib/bibcode-server-package/workstation-root"
if [ ! -f "$owner_file" ]; then
  exit 0
fi

package_user=$(/bin/sed -n '1p' "$owner_file")
case "$package_user" in
  ""|root|*[!A-Za-z0-9._-]*)
    echo "BiBCode Server: invalid package service owner receipt; refusing service mutation." >&2
    exit 1
    ;;
esac
/usr/bin/getent passwd "$package_user" >/dev/null
package_home=$(/usr/bin/getent passwd "$package_user" | /usr/bin/cut -d: -f6)
if [ -f "$root_file" ]; then
  data_root=$(/bin/sed -n '1p' "$root_file")
else
  data_root="$package_home/.bibcode"
fi
case "$package_home:$data_root" in
  /*:/*) ;;
  *)
    echo "BiBCode Server: invalid package service owner home or data root." >&2
    exit 1
    ;;
esac

if [ "$1" -eq 0 ]; then
  /usr/sbin/runuser -u "$package_user" -- \
    /usr/bin/env HOME="$package_home" USER="$package_user" LOGNAME="$package_user" \
    /usr/bin/bibcode service uninstall --mode workstation --format json --base-dir "$data_root"
  /bin/rm -f "$owner_file" "$root_file"
  echo "BiBCode Server: service registration removed; the data root is preserved."
else
  :
fi
