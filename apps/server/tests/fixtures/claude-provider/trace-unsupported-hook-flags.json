      "line": "{\"version\":\"1.0.0\",\"help_flags\":[\"--print\",\"--input-format\",\"--output-format\",\"--include-partial-messages\",\"--verbose\"]}"
    },
    {
      "source": "baseLaunch",
      "line": "{\"functional\":true,\"arguments\":[\"--print\",\"--input-format\",\"stream-json\",\"--output-format\",\"stream-json\",\"--include-partial-messages\",\"--verbose\"]}"
    }
