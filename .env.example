# Optional: BiBCode Connect source builds
# Leave these unset to disable optional BiBCode Connect features in local source builds.
# Release builds inject their public values at build time. Do not add server-side
# secrets to this file.

# Get these from the Clerk Dashboard under API keys, JWT templates, and OAuth applications.
# BIBCODE_CLERK_PUBLISHABLE_KEY=pk_test_...
# BIBCODE_CLERK_JWT_TEMPLATE=bibcode-relay
# BIBCODE_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in BIBCODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# BIBCODE_APPLE_TEAM_ID=ABC1234567
# BIBCODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/bibcode.provisionprofile
# BIBCODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Get this from your relay deployment. `infra/relay` deploys update it automatically.
# BIBCODE_RELAY_URL=https://relay.example.com
